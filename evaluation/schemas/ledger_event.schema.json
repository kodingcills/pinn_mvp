{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haplous.local/schemas/ledger_event-v0.json",
  "title": "M0 append-only ledger event (provisional)",
  "type": "object",
  "additionalProperties": false,
  "required": ["seq", "at", "run_id", "event", "state", "payload", "prev_hash", "hash"],
  "properties": {
    "seq": {"type": "integer", "minimum": 0},
    "at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "run_id": {"type": ["string", "null"]},
    "event": {"enum": ["registered", "started", "completed", "failed", "verified", "integrity_failed", "approval_recorded", "rejected_input"]},
    "state": {"enum": ["REGISTERED", "RUNNING", "COMPLETED", "FAILED", "VERIFIED", "INTEGRITY_FAILED", "REJECTED"]},
    "payload": {"type": "object"},
    "prev_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
