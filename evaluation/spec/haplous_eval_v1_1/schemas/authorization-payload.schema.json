{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haplous.dev/eval/schemas/v1.1/authorization-payload.schema.json",
  "title": "Haplous Tier 3 Immutable Authorization Payload v1.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "nonce": {
      "type": "string",
      "minLength": 32
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "incumbent_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "policy_checkpoint_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "benchmark_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "trusted_runner_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "scorer_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "analysis_code_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "holdout_allocation_policy": {
      "type": "object",
      "properties": {
        "pool_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "selection_rule": {
          "enum": [
            "next_available",
            "independent_random"
          ]
        },
        "scenario_count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "pool_id",
        "selection_rule",
        "scenario_count"
      ],
      "additionalProperties": false
    },
    "analysis_plan": {
      "type": "object",
      "properties": {
        "primary_metric": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "effect_direction": {
          "enum": [
            "higher_better",
            "lower_better"
          ]
        },
        "min_worthwhile_effect_pp": {
          "type": "number",
          "minimum": 0
        },
        "alpha": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "test": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "cluster_unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "success_rule": {
          "type": "string",
          "minLength": 8
        },
        "guardrails": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "missing_data_policy": {
          "type": "string",
          "minLength": 8
        }
      },
      "required": [
        "primary_metric",
        "effect_direction",
        "min_worthwhile_effect_pp",
        "alpha",
        "test",
        "cluster_unit",
        "success_rule",
        "guardrails",
        "missing_data_policy"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "gpu_hours_max": {
          "type": "number",
          "minimum": 0
        },
        "wall_clock_hours_max": {
          "type": "number",
          "minimum": 0
        },
        "cost_usd_max": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "gpu_hours_max",
        "wall_clock_hours_max",
        "cost_usd_max"
      ],
      "additionalProperties": false
    },
    "output_release_policy": {
      "enum": [
        "aggregate_only",
        "investigative_release"
      ]
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "preflight_report_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "variant_registry_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "agent_rationale": {
      "type": "string",
      "maxLength": 4000
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "issued_at",
    "expires_at",
    "nonce",
    "candidate_digest",
    "incumbent_digest",
    "policy_checkpoint_digest",
    "benchmark_digest",
    "trusted_runner_digest",
    "scorer_digest",
    "analysis_code_digest",
    "holdout_allocation_policy",
    "analysis_plan",
    "budget",
    "output_release_policy",
    "stop_conditions",
    "preflight_report_digest",
    "variant_registry_digest"
  ],
  "description": "Immutable Tier 3 requested operation, hashed as sha256(RFC8785/JCS(payload)). Separate from mutable ledger state. Signature permission is NOT conferred by schema acceptance."
}
